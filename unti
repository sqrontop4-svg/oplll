    function S.addButtonFeedback(btn)
        if not btn or not btn:IsA("GuiButton") then return end
        if btn:GetAttribute("SQRFeedback") then return end
        btn:SetAttribute("SQRFeedback", true)

        local sound = Instance.new("Sound")
        sound.Name = "SQRButtonClick"
        sound.SoundId = S.SQR_BUTTON_SOUND_ID
        sound.Volume = 0.35
        sound.Parent = btn

        local baseSize = btn.Size
        local activeDown, activeUp

        btn.Activated:Connect(function()
            if not btn or not btn.Parent then return end
            pcall(function() sound.SoundId = S.SQR_BUTTON_SOUND_ID; sound:Play() end)

            pcall(function() if activeDown then activeDown:Cancel() end end)
            pcall(function() if activeUp then activeUp:Cancel() end end)
            btn.Size = baseSize

            local pressedSize = UDim2.new(
                baseSize.X.Scale * 0.97, math.floor(baseSize.X.Offset * 0.97),
                baseSize.Y.Scale * 0.92, math.floor(baseSize.Y.Offset * 0.92)
            )

            activeDown = S.TweenService:Create(btn, TweenInfo.new(0.055, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = pressedSize})
            activeUp = S.TweenService:Create(btn, TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = baseSize})
            activeDown:Play()
            activeDown.Completed:Connect(function()
                if btn and btn.Parent and activeUp then
                    activeUp:Play()
                end
            end)
        end)
    end
    
    function S.installButtonFeedback(root)
        if not root then return end
        for _, obj in ipairs(root:GetDescendants()) do
