    S.antiPlayerConnectionsByPlayer=S.antiPlayerConnectionsByPlayer or {}
    S.antiChatConnections=S.antiChatConnections or {}

    local function clearConnectionList(list)
        for i=#list,1,-1 do
            pcall(function() list[i]:Disconnect() end)
            list[i]=nil
        end
    end

    local function disconnectAntiPlayerConnection(player)
        local conn=S.antiPlayerConnectionsByPlayer[player]
        if conn then pcall(function() conn:Disconnect() end) end
        S.antiPlayerConnectionsByPlayer[player]=nil
    end

    local function hidePlayerCharacter(character)
        if not S.antiPlayerActive or not character then return end
        pcall(function() character:Destroy() end)
    end

    local function showPlayerCharacter(character)
        if not character then return end
        for _,obj in ipairs(character:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.LocalTransparencyModifier=0
                    obj.CastShadow=true
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency=0
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled=true
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
                    or obj:IsA("Highlight") then
                    obj.Enabled=true
                end
            end)
        end
        pcall(function()
            local humanoid=character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer end
        end)
    end

    local function cleanPlayerCharacter(plr)
        if not S.antiPlayerActive or not plr or plr==LocalPlayer then return end
        local char=plr.Character
        if char then hidePlayerCharacter(char) end
    end

    local function watchAntiPlayer(player)
