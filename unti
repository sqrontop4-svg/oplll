do
    local S = _G.SQR
    
    function S.sectionAllowed(sectionName)
        return true
    end

    function S.refreshSectionVisibility()
        local currentName = S.sections[S.currentSection] or "Setting"
        if not S.sectionAllowed(currentName) then
            S.currentSection = 1
        end
        local slot = 0
        for j, sf in ipairs(S.sectionFrames or {}) do
            local name = S.sections[j]
            local allowed = S.sectionAllowed(name)
            local active = allowed and j == S.currentSection
            if sf then
                sf.Visible = active
                sf.Active = active
                sf.ZIndex = 4
            end
            local btn = S.sectionButtons[j]
            if btn then
                btn.Visible = allowed
                btn.Active = allowed
                btn.ZIndex = 20
                if allowed then
                    slot = slot + 1
                    btn.Position = UDim2.new(0.06, 0, 0.02 + (slot - 1) * 0.082, 0)
                end
                btn.BackgroundColor3 = active and Color3.fromRGB(0,200,0) or Color3.fromRGB(30,30,45)
                btn.BackgroundTransparency = active and 0 or 0.4
                btn.TextColor3 = active and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
                btn.TextTransparency = 0
            end
        end
    end

    function S.switchSectionByName(sectionName)
        for i,name in ipairs(S.sections) do
            if name==sectionName then
                if not S.sectionAllowed(name) then return false end
                S.currentSection=i
                S.refreshSectionVisibility()
                return true
            end
        end
        return false
    end

end

