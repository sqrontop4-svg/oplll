        S.SaveOriginalPosition("HeadBang")
        S.PlayDanceAnimations(S.HeadBangSpeed)
        local oscillationTime = 0
        S.headbangTask = task.spawn(function()
            while S.HeadBangActive and targetPlayer and targetPlayer.Character do
                pcall(function()
                    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local targetHead = targetPlayer.Character:FindFirstChild("Head")
                    local movementChar = getMovementCharacter()
                    local playerRoot = movementChar and movementChar:FindFirstChild("HumanoidRootPart")
                    local humanoid = movementChar and movementChar:FindFirstChildOfClass("Humanoid")
                    if targetRoot and playerRoot then
                        local baseDistance = math.clamp(tonumber(S.HeadBangDistance) or 200, 1, 500) / 100
                        local heightOffset = math.clamp(tonumber(S.HeadBangHeight) or 0, 0, 1000) / 100
                        local oscillationMultiplier = math.clamp(tonumber(S.HeadBangOscillation) or 1.5, 1, 10)
                        local travelSpeed = math.max(tonumber(S.HeadBangMoveSpeed) or 1, 1)
                        oscillationTime = oscillationTime + (0.1 * travelSpeed)
                        local osc = math.sin(oscillationTime) * baseDistance * oscillationMultiplier * 0.5
                        local actualDistance = math.clamp(baseDistance + osc, 0.5, 10)
                        local headPos = targetHead and targetHead.Position or (targetRoot.Position + Vector3.new(0, 1.5, 0))
                        local lookVector = targetRoot.CFrame.LookVector
                        local position = headPos + (lookVector * actualDistance) + Vector3.new(0, heightOffset, 0)
                        playerRoot.AssemblyLinearVelocity = Vector3.zero
                        playerRoot.AssemblyAngularVelocity = Vector3.zero
                        playerRoot.CFrame = CFrame.lookAt(position, headPos)
                        if humanoid then humanoid.AutoRotate = false end
                        S.AdjustDanceAnimations(S.HeadBangSpeed)
                    end
                end)
                task.wait(0.08)
            end
            local humanoid = S.player.Character and S.player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.AutoRotate = true end
            S.StopDanceAnimation()
            S.HeadBangActive = false
            S.RestoreOriginalPosition("HeadBang")
        end)
    end

    function S.StopBang()
        S.BangActive = false
        S.HeadBangActive = false
        if S.bangTask then pcall(function() task.cancel(S.bangTask) end); S.bangTask = nil end
        if S.headbangTask then pcall(function() task.cancel(S.headbangTask) end); S.headbangTask = nil end
        local movementChar = getMovementCharacter()
        local humanoid = movementChar and movementChar:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.AutoRotate = true end
        S.StopDanceAnimation()
        S.RestoreOriginalPosition("Bang")
        S.RestoreOriginalPosition("HeadBang")
    end

    S.player.CharacterAdded:Connect(function()
        if S.BangActive or S.HeadBangActive then
            wait(1)
            if S.BangActive then S.PlayDanceAnimation(S.BangSpeed)
            elseif S.HeadBangActive then S.PlayDanceAnimation(S.HeadBangSpeed) end
        end
    end)
end

