    local function cleanTargetAvatar(character)
        for _,obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                obj:Destroy()
            elseif obj:IsA("Highlight") or obj:IsA("SelectionBox") or obj:IsA("SelectionSphere")
                or obj:IsA("BoxHandleAdornment") or obj:IsA("SphereHandleAdornment")
                or obj:IsA("ConeHandleAdornment") or obj:IsA("CylinderHandleAdornment")
                or obj:IsA("LineHandleAdornment") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Anchored = true
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Transparency = 0
                pcall(function() obj.LocalTransparencyModifier = 0 end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 0
            end
        end
    end

    local function createTargetDescriptionModel(plr)
        if not plr then return nil end

        -- First use the target's real Character. This preserves the exact
        -- current skin, body, accessories, layered clothing and colors.
        local liveCharacter = plr.Character
        if liveCharacter and liveCharacter.Parent then
            local archivableStates = {}
            pcall(function()
                for _,obj in ipairs(liveCharacter:GetDescendants()) do
                    if obj:IsA("Instance") then
                        archivableStates[obj] = obj.Archivable
                        obj.Archivable = true
                    end
                end
                archivableStates[liveCharacter] = liveCharacter.Archivable
                liveCharacter.Archivable = true
            end)
            local clone
            pcall(function() clone = liveCharacter:Clone() end)
            for obj,oldValue in pairs(archivableStates) do
                pcall(function() obj.Archivable = oldValue end)
            end
            if clone then
                cleanTargetAvatar(clone)
                clone.Name = "DisplayedAvatar"
                clone.Parent = S.targetViewerWorld
                for _,obj in ipairs(clone:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        obj.Anchored = true
                        obj.CanCollide = false
                        obj.CanTouch = false
                        obj.CanQuery = false
                        obj.Transparency = 0
                        pcall(function() obj.LocalTransparencyModifier = 0 end)
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = 0
                    end
                end
                local root = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
                if root then
                    clone.PrimaryPart = root
                    clone:PivotTo(CFrame.new(0,0,0))
                end
                return clone
            end
        end

        -- Fallback: recreate the avatar from its HumanoidDescription, matching
        -- the supplied SQRPlayerViewer implementation.
        local description
        pcall(function()
            description = Players:GetHumanoidDescriptionFromUserId(plr.UserId)
        end)
        if not description then
            pcall(function()
                description = Players:GetHumanoidDescriptionFromUserIdAsync(plr.UserId)
            end)
        end
        if not description then return nil end

        local character
        pcall(function()
            character = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
        end)
        if not character then
            pcall(function()
                character = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
            end)
        end
        if not character then return nil end

        cleanTargetAvatar(character)
        character.Name = "DisplayedAvatar"
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.AutoRotate = false
            humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
        character.Parent = S.targetViewerWorld
        for _,obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Anchored = true
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Transparency = 0
                pcall(function() obj.LocalTransparencyModifier = 0 end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 0
            end
        end
        local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        if root then
            character.PrimaryPart = root
            character:PivotTo(CFrame.new(0,0,0))
        end
        return character
    end

    local function createTargetCharacterClone(character)
        if not character or not character.Parent then return nil end
        local oldArchivable = character.Archivable
        pcall(function() character.Archivable = true end)
        local clone
        pcall(function() clone = character:Clone() end)
        pcall(function() character.Archivable = oldArchivable end)
        if clone then cleanTargetAvatar(clone) end
        return clone
    end

    local function updateTargetViewerCamera(dt)
        local targetClone = S.targetViewerTargetClone
        if not targetClone or not targetClone.Parent then return end
        local root = targetClone:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local head = targetClone:FindFirstChild("Head")
        local boxCFrame, boxSize = targetClone:GetBoundingBox()
        local focus = head and head.Position or boxCFrame.Position

        local yawDiff = S.targetViewerTargetCameraYaw - S.targetViewerCameraYaw
        while yawDiff > 180 do yawDiff = yawDiff - 360 end
        while yawDiff < -180 do yawDiff = yawDiff + 360 end
        S.targetViewerCameraYaw = S.targetViewerCameraYaw + yawDiff * math.clamp(dt * 12,0,1)
        S.targetViewerCameraPitch = S.targetViewerCameraPitch + (S.targetViewerTargetCameraPitch-S.targetViewerCameraPitch)*math.clamp(dt*12,0,1)

        local yaw = math.rad(S.targetViewerCameraYaw)
        local pitch = math.rad(S.targetViewerCameraPitch)
        local horizontal = math.cos(pitch) * S.targetViewerDistance
        local fitDistance = math.max((boxSize.Magnitude * 0.45), 3.5)
        local cameraDistance = math.max(S.targetViewerDistance, fitDistance)
        local offset = Vector3.new(math.sin(yaw)*horizontal, 1.25 + math.sin(pitch)*cameraDistance, math.cos(yaw)*horizontal)
        if horizontal < cameraDistance then
            local flat = math.max(math.cos(pitch) * cameraDistance, 3.5)
            offset = Vector3.new(math.sin(yaw)*flat, 1.25 + math.sin(pitch)*cameraDistance, math.cos(yaw)*flat)
        end
        S.targetViewerCamera.FieldOfView = 38
        S.targetViewerCamera.CFrame = CFrame.lookAt(root.Position + offset, focus, Vector3.new(0,1,0))
    end

