        local function antiLagRestore()
            pcall(function()
                local Lighting=game:GetService("Lighting")
                if antiLagState.globalShadows~=nil then Lighting.GlobalShadows=antiLagState.globalShadows end
                if antiLagState.environmentDiffuseScale~=nil then Lighting.EnvironmentDiffuseScale=antiLagState.environmentDiffuseScale end
                if antiLagState.environmentSpecularScale~=nil then Lighting.EnvironmentSpecularScale=antiLagState.environmentSpecularScale end
                if antiLagState.shadowSoftness~=nil then Lighting.ShadowSoftness=antiLagState.shadowSoftness end
                if antiLagState.lightingTechnology~=nil then pcall(function() Lighting.Technology=antiLagState.lightingTechnology end) end
                if antiLagState.qualityLevel~=nil then pcall(function() settings().Rendering.QualityLevel=antiLagState.qualityLevel end) end
            end)
            pcall(function()
                for obj,data in pairs(antiLagState.disabledObjects or {}) do
                    if obj and obj.Parent then obj.Enabled=data end
                end
                for obj,data in pairs(antiLagState.changedParts or {}) do
                    if obj and obj.Parent then
                        obj.CastShadow=data.CastShadow
                        pcall(function() obj.Material=data.Material end)
                    end
                end
                for obj,data in pairs(antiLagState.changedTextures or {}) do
                    if obj and obj.Parent then obj.Transparency=data.Transparency end
                end
                local Terrain=workspace:FindFirstChildOfClass("Terrain")
                local td=antiLagState.terrain
                if Terrain and td then
                    Terrain.Decoration=td.Decoration
                    Terrain.WaterWaveSize=td.WaterWaveSize
                    Terrain.WaterWaveSpeed=td.WaterWaveSpeed
                    Terrain.WaterReflectance=td.WaterReflectance
                    Terrain.WaterTransparency=td.WaterTransparency
                end
            end)
            antiLagState.disabledObjects={}
            antiLagState.changedParts={}
            antiLagState.changedTextures={}
            antiLagState.terrain=nil
            antiLagState.qualityLevel=nil
            antiLagState.globalShadows=nil
            antiLagState.environmentDiffuseScale=nil
            antiLagState.environmentSpecularScale=nil
            antiLagState.shadowSoftness=nil
            antiLagState.lightingTechnology=nil
            antiLagState.applied=false
        end

        local function antiLagApply()
            if antiLagState.applied then return end
            antiLagState.applied=true
            -- Strong client-side render reduction. Every changed value is stored so AntiLag can restore it.
            pcall(function()
                for _,obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
                        or obj:IsA("PostEffect") then
                        antiLagState.disabledObjects[obj]=obj.Enabled
                        obj.Enabled=false
                    elseif obj:IsA("BasePart") then
                        antiLagState.changedParts[obj]={CastShadow=obj.CastShadow,Material=obj.Material}
                        obj.CastShadow=false
                        pcall(function() obj.Material=Enum.Material.SmoothPlastic end)
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        antiLagState.changedTextures[obj]={Transparency=obj.Transparency}
                        obj.Transparency=1
                    end
                end
            end)
            pcall(function()
                local Terrain=workspace:FindFirstChildOfClass("Terrain")
                if Terrain then
                    antiLagState.terrain={
                        Decoration=Terrain.Decoration,
                        WaterWaveSize=Terrain.WaterWaveSize,
                        WaterWaveSpeed=Terrain.WaterWaveSpeed,
                        WaterReflectance=Terrain.WaterReflectance,
                        WaterTransparency=Terrain.WaterTransparency
                    }
                    Terrain.Decoration=false
                    Terrain.WaterWaveSize=0
                    Terrain.WaterWaveSpeed=0
                    Terrain.WaterReflectance=0
                    Terrain.WaterTransparency=1
                end
            end)
            pcall(function()
                local Lighting=game:GetService("Lighting")
                antiLagState.globalShadows=Lighting.GlobalShadows
                antiLagState.environmentDiffuseScale=Lighting.EnvironmentDiffuseScale
                antiLagState.environmentSpecularScale=Lighting.EnvironmentSpecularScale
                antiLagState.shadowSoftness=Lighting.ShadowSoftness
                pcall(function() antiLagState.lightingTechnology=Lighting.Technology end)
                Lighting.GlobalShadows=false
                Lighting.EnvironmentDiffuseScale=0
                Lighting.EnvironmentSpecularScale=0
                Lighting.ShadowSoftness=0
                pcall(function() Lighting.Technology=Enum.Technology.Compatibility end)
