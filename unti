                    obj.TextTransparency = 0
                end
            elseif obj:IsA("TextLabel") or obj:IsA("ImageLabel") then
                obj.Visible = true
                obj.ZIndex = 80
                if obj:IsA("TextLabel") then obj.TextTransparency = 0 end
            elseif obj:IsA("Frame") and obj.Parent and obj.Parent:IsA("ScrollingFrame") then
                obj.ZIndex = math.max(obj.ZIndex, 70)
            end
        end
    end
    for _, sf in ipairs(S.sectionFrames or {}) do
