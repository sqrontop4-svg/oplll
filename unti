    local function setSignalState(disable)
        local execute=resolveExecuteClientCommand()
        if not execute or typeof(getconnections)~="function" then return false end
        local ok=pcall(function()
            local connections=getconnections(execute.OnClientEvent)
            for _,conn in ipairs(connections) do
                pcall(function()
                    if disable then
                        if conn.Disable then conn:Disable() end
                    else
                        if conn.Enable then conn:Enable() end
                    end
                end)
            end
        end)
        return ok
    end

    local function installNVHook()
        if _G.SQR_NV_FIRE_HOOK_INSTALLED then return end
        local execute=S.executeCmd
        if not execute or typeof(firesignal)~="function" or typeof(hookfunction)~="function" then return end
        local oldFireSignal=firesignal
        local installed=false
        local ok=pcall(function()
            hookfunction(firesignal,function(signal,...)
                local cur=_G.SQR
                if cur and signal==cur.executeCmd and (cur.nvActive or cur.warpActive) then
                    local argc=select("#",...)
                    for i=1,argc do
                        local v=select(i,...)
                        if type(v)=="string" then
                            v=v:lower()
                            if (cur.nvActive and (v=="nightvision" or v=="nv"))
                                or (cur.warpActive and v=="warp") then
                                return nil
                            end
                        end
                    end
                end
                return oldFireSignal(signal,...)
            end)
            installed=true
        end)
        if ok and installed then
            _G.SQR_NV_FIRE_HOOK_INSTALLED=true
            _G.SQR_NV_OLD_FIRESIGNAL=oldFireSignal
        end
    end

    local function refreshProtectionSignal()
        local execute=resolveExecuteClientCommand()
        if not execute then return nil end
        installNVHook()
        -- ExecuteClientCommand is the actual client command signal.
        -- Disable its listeners while either AntiNV or AntiWarp is active,
        -- then restore them when both protections are OFF.
        if S.nvActive or S.warpActive then
            setSignalState(true)
        else
            setSignalState(false)
        end
        return execute
    end

