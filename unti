        function S.startFly()
            local char = S.player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            S.stopFly()
            S.settingState.flying = true
            S.flyHumanoid = hum
            S.flyOldAutoRotate = hum.AutoRotate
            hum.AutoRotate = false

            S.flyVelocity = Instance.new("BodyVelocity")
            S.flyVelocity.MaxForce = Vector3.new(1e7,1e7,1e7)
            S.flyVelocity.P = 10000
            S.flyVelocity.Velocity = Vector3.zero
            S.flyVelocity.Parent = root

            S.flyGyro = Instance.new("BodyGyro")
            S.flyGyro.MaxTorque = Vector3.new(1e7,1e7,1e7)
            S.flyGyro.P = 10000
            S.flyGyro.D = 500
            S.flyGyro.CFrame = root.CFrame
            S.flyGyro.Parent = root

            S.flyConnection = S.RunService.RenderStepped:Connect(function()
                if not S.settingState.flying or not root.Parent or not hum.Parent then
                    S.stopFly()
                    return
                end
                local cam = S.Workspace.CurrentCamera
                if not cam then return end

                local move = hum.MoveDirection
                local look = cam.CFrame.LookVector
                local right = cam.CFrame.RightVector
                local horizontalLook = Vector3.new(look.X, 0, look.Z)
                local horizontalRight = Vector3.new(right.X, 0, right.Z)
                if horizontalLook.Magnitude > 0 then horizontalLook = horizontalLook.Unit end
                if horizontalRight.Magnitude > 0 then horizontalRight = horizontalRight.Unit end

                local keyboardMove = Vector3.zero
                if S.UIS:IsKeyDown(Enum.KeyCode.W) then keyboardMove = keyboardMove + horizontalLook end
                if S.UIS:IsKeyDown(Enum.KeyCode.S) then keyboardMove = keyboardMove - horizontalLook end
                if S.UIS:IsKeyDown(Enum.KeyCode.D) then keyboardMove = keyboardMove + horizontalRight end
                if S.UIS:IsKeyDown(Enum.KeyCode.A) then keyboardMove = keyboardMove - horizontalRight end
                if keyboardMove.Magnitude > 0 then move = keyboardMove end

                local vertical = 0
                if S.UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then vertical = vertical + 1 end
                if S.UIS:IsKeyDown(Enum.KeyCode.LeftControl) or S.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = vertical - 1 end

                local direction = Vector3.new(move.X, vertical, move.Z)
                local speed = math.clamp(tonumber(S.settingState.flySpeed) or 50,1,1000)
                S.flyVelocity.Velocity = direction.Magnitude > 0 and direction.Unit * speed or Vector3.zero

                local face = Vector3.new(look.X, 0, look.Z)
                if face.Magnitude > 0 then
                    S.flyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + face.Unit)
                end
            end)
            S.flyBtn.Text = "Unfly"
            S.flyBtn.BackgroundColor3 = Color3.fromRGB(40,150,90)
        end

