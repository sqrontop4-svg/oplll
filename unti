            pcall(function() S.afkConnection:Disconnect() end)
            S.afkConnection = nil
        end
        if S.afkMoveTask then
            pcall(function() task.cancel(S.afkMoveTask) end)
            S.afkMoveTask = nil
        end
        pcall(function()
            local char = S.player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:Move(Vector3.zero, false); hum.Jump=false end
        end)
    end
    
    function S.getNearPlayers()
        local near = {}
        local char = S.player.Character
        if not char then return near end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return near end
        for _, plr in ipairs(S.Players:GetPlayers()) do
            if plr ~= S.player and plr.Character then
