    S._remoteCommandToken = S._remoteCommandToken or 0
    S._activeRemoteTags = S._activeRemoteTags or {}

    local function runRemoteQueue()
        if S._remoteWorkerRunning then return end
        S._remoteWorkerRunning = true
        task.spawn(function()
            while S.remoteCommandAlive ~= false and #S._remoteSendQueue > 0 do
                local job = table.remove(S._remoteSendQueue, 1)
                local now=os.clock()
                local remain=(S._remoteMinInterval or 0.035)-(now-(S._remoteLastDispatch or 0))
                if remain>0 then task.wait(remain) end
                if job and type(job.fn) == "function" then
                    if not job.tag or not S._cancelledRemoteTags[job.tag] then
                        S._remoteLastDispatch=os.clock()
                        pcall(job.fn)
                    end
                end
                task.wait()
            end
            S._remoteWorkerRunning = false
        end)
    end

    function S.enqueueRemoteJob(fn, tag)
        if S.requestProtectionEnabled and not S._requestProtectionAllow then return false end
        if type(fn) ~= "function" then return false end
        if tag then
            for i=#S._remoteSendQueue,1,-1 do
                local pending=S._remoteSendQueue[i]
                if pending and pending.tag==tag then
                    table.remove(S._remoteSendQueue,i)
                end
            end
        end
        if #S._remoteSendQueue >= S._remoteQueueLimit then
            table.remove(S._remoteSendQueue, 1)
        end
        table.insert(S._remoteSendQueue, {fn=fn, tag=tag})
        runRemoteQueue()
        return true
    end

    function S.cancelRemoteJobs(tag)
        if not tag then return end
        S._cancelledRemoteTags[tag]=true
        S._activeRemoteTags[tag]=nil
        for i=#S._remoteSendQueue,1,-1 do
            local job=S._remoteSendQueue[i]
            if job and job.tag==tag then
                table.remove(S._remoteSendQueue,i)
            end
        end
    end

    function S.cancelAllRemoteJobs()
        S._remoteCommandToken=(S._remoteCommandToken or 0)+1
        for tag in pairs(S._activeRemoteTags or {}) do
            S._cancelledRemoteTags[tag]=true
        end
        S._activeRemoteTags={}
        S._remoteSendQueue={}
    end

    function S.sendCommand(cmd, tag)
        if S.requestProtectionEnabled then
            S._requestProtectionAllow = true
        end
        cmd=tostring(cmd or "")
        if cmd=="" then
            S._requestProtectionAllow=false
            return false
        end
        local remotes=S._hdRemotes or getHDRemotes()
        tag=tag or ("Command:"..tostring((S._remoteCommandToken or 0)+1))
        S._remoteCommandToken=(S._remoteCommandToken or 0)+1
        local token=S._remoteCommandToken
        S._cancelledRemoteTags[tag]=nil
        S._activeRemoteTags[tag]=token
        local queued=S.enqueueRemoteJob(function()
            if S._activeRemoteTags[tag]~=token or S._cancelledRemoteTags[tag] then return end
            for i=1,#remotes do
                if S._activeRemoteTags[tag]~=token or S._cancelledRemoteTags[tag] then break end
