-- SQR_FINAL_UI_STYLE_NORMALIZER
do
    local S=_G.SQR
    local function isSittingObject(obj)
        local cur=obj
        for _=1,5 do
            if not cur then break end
            local n=string.lower(tostring(cur.Name or ""))
            if n:find("sitting",1,true) or n:find("sitting",1,true) or n=="sit" then return true end
            cur=cur.Parent
        end
        return false
    end
    local function normalize(root)
        if not root then return end
        for _,obj in ipairs(root:GetDescendants()) do
            if not isSittingObject(obj) then
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    obj.BorderSizePixel=0
                    local corner=obj:FindFirstChildOfClass("UICorner")
                    if not corner then corner=Instance.new("UICorner"); corner.Parent=obj end
                    corner.CornerRadius=UDim.new(0,8)
                    if obj:IsA("TextButton") then
                        obj.Font=Enum.Font.SourceSansBold
                        if not obj.TextScaled then obj.TextSize=14 end
                    end
                elseif obj:IsA("TextBox") then
                    obj.BorderSizePixel=0
                    local corner=obj:FindFirstChildOfClass("UICorner")
                    if not corner then corner=Instance.new("UICorner"); corner.Parent=obj end
                    corner.CornerRadius=UDim.new(0,8)
                    obj.Font=Enum.Font.SourceSans
                    obj.TextSize=14
                end
            end
        end
    end
    pcall(function() normalize(S.mainGui) end)
end
