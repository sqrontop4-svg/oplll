        function S.saveLastBackground(name,id)
            local cleanId = tostring(id or ""):gsub("%s+", "")
            cleanId = cleanId:gsub("rbxassetid://", "")
            if cleanId == "" or not tonumber(cleanId) then return false end

            local payload = {
                background = cleanId,
                backgroundName = tostring(name or "Custom")
            }

            local okEncode, encoded = pcall(function()
                return S.HttpService:JSONEncode(payload)
            end)
            if not okEncode or not encoded then return false end

            if type(writefile) == "function" then
                local ok = pcall(function()
                    writefile(S.BACKGROUND_FILE, encoded)
                end)
                if ok then return true end
            end

            if type(savefile) == "function" then
                local ok = pcall(function()
                    savefile(S.BACKGROUND_FILE, encoded)
                end)
                if ok then return true end
            end

            return false
        end

        function S.loadLastBackground()
            if type(isfile) ~= "function" or type(readfile) ~= "function" then
                return nil,nil
            end

            local exists = false
            pcall(function()
                exists = isfile(S.BACKGROUND_FILE)
            end)
            if not exists then return nil,nil end

            local okRead, content = pcall(function()
                return readfile(S.BACKGROUND_FILE)
            end)
            if not okRead or not content or content == "" then return nil,nil end

            local okDecode, data = pcall(function()
                return S.HttpService:JSONDecode(content)
            end)
            if not okDecode or type(data) ~= "table" then return nil,nil end

            local id = tostring(data.background or ""):gsub("%s+", "")
            id = id:gsub("rbxassetid://", "")
            if id == "" or not tonumber(id) then return nil,nil end

            return id, tostring(data.backgroundName or "Custom")
        end

