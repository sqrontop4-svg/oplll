do
    local S = _G.SQR
    
    local function findTargetMatches(query)
        query=tostring(query or ""):lower():gsub("^%s+",""):gsub("%s+$","")
        local matches={}
        if query=="" then return matches end
        for _,plr in ipairs(S.Players:GetPlayers()) do
            if plr~=S.player and (not S.canTargetPlayer or S.canTargetPlayer(plr)) then
                local name=tostring(plr.Name or ""):lower()
                local display=tostring(plr.DisplayName or ""):lower()
                if name==query or display==query or name:find(query,1,true) or display:find(query,1,true) then
                    table.insert(matches,plr)
                end
            end
        end
        return matches
    end
    S.findTargetMatches=findTargetMatches

    local function scanAndSelectTarget()
        local matches=findTargetMatches(S.searchBox.Text)
        if matches[1] then
            S.updateTargetUI(matches[1])
        elseif tostring(S.searchBox.Text or ""):gsub("%s+","")=="" then
            S.updateTargetUI(nil)
        else
            S.updateTargetUI(nil)
        end
        return matches
    end

    S.searchBox:GetPropertyChangedSignal("Text"):Connect(scanAndSelectTarget)
    S.searchBox.FocusLost:Connect(function() scanAndSelectTarget() end)

    S.Players.PlayerAdded:Connect(function(plr)
        local uid=tostring(plr.UserId)
        S.playerJoinTimes[uid]=os.clock()
        task.spawn(function()
            if S.searchBox and tostring(S.searchBox.Text or "")~="" then scanAndSelectTarget() end
        end)
    end)
    
    S.Players.PlayerRemoving:Connect(function(plr)
        pcall(function()
            local uid=tostring(plr.UserId)
            S.cloudRecord.activeUsers=S.cloudRecord.activeUsers or {}
            S.cloudRecord.removedUsers=S.cloudRecord.removedUsers or {}
            S.cloudRecord.activeUsers[uid]=nil
            S.cloudRecord.removedUsers[uid]=true
            S.ownerKnownUsers[uid]=nil
            if S.ownerRefresh then S.ownerRefresh() end
            task.spawn(function() pcall(function() S.putCloudRecord(S.cloudRecord) end) end)
        end)
        if plr == S.selectedPlayer then
            local uid=tostring(plr.UserId)
            S.playerLeaveData[uid]=(S.playerLeaveData[uid] or 0)+1
            S.leftPlayersData[uid]={
                shouldReselect=true,
                leaveCount=S.playerLeaveData[uid]
            }
            S.ShowLeavePopup(plr,S.playerLeaveData[uid])
            S.playerJoinTimes[uid]=nil
            S.ResetTargetActions()
            S.updateTargetUI(nil)
        end
    end)
    
    S.Players.PlayerAdded:Connect(function(plr)
        local uid=tostring(plr.UserId)
        if S.leftPlayersData[uid] and S.leftPlayersData[uid].shouldReselect then
            task.wait(0.5)
            if not S.selectedPlayer then S.updateTargetUI(plr) end
            S.leftPlayersData[uid]=nil
        end
    end)
end

