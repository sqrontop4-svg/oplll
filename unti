                    local row=Instance.new("Frame"); row.Size=UDim2.new(1,-8,0,36); row.BackgroundColor3=Color3.fromRGB(34,38,50); row.Parent=S.ownerResetFrame; Instance.new("UICorner",row).CornerRadius=UDim.new(0,7)
