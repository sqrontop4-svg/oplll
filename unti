                    local t=Instance.new("TextLabel"); t.Size=UDim2.new(1,-85,1,0); t.Position=UDim2.fromOffset(7,0); t.BackgroundTransparency=1; t.Text="@"..info.name.." • VIP • Kick: 5/"..math.min(used,5); t.TextColor3=Color3.new(1,1,1); t.TextSize=11; t.Font=Enum.Font.GothamBold; t.TextXAlignment=Enum.TextXAlignment.Left; t.Parent=row
                    local r=mini(row,"RESET",0,1,65,Color3.fromRGB(45,130,85)); r.Position=UDim2.new(1,-72,0,1); r.Activated:Connect(function() S.resetVIPKicks(info.name) end)
                end
            end
            if vipCount==0 then label(S.ownerResetFrame,"لا يوجد VIP حالياً",8,30,12) end
            S.ownerResetFrame.CanvasSize=UDim2.fromOffset(0,math.max(42,vipCount*40+8))
            sfOwner.CanvasSize=UDim2.fromOffset(0,485+math.max(0,count*124))
        end
    end

    task.wait(0.15)
    pcall(function()
        if S.refreshSectionVisibility then S.refreshSectionVisibility() end
        if S.vipRefresh then S.vipRefresh() end
        if S.ownerRefresh then S.ownerRefresh() end
    end)
end


