        function S.ownerRefresh()
            if not S.isOwner then return end
            local active=S.getActiveScriptUsers()
            local present={}
            for _,info in ipairs(active) do
                if tonumber(info.userId)~=S.player.UserId then
                    present[tostring(info.userId)]=true
                    S.ownerKnownUsers[tostring(info.userId)]=info
                end
            end
            local livePlayers={}
            for _,plr in ipairs(S.Players:GetPlayers()) do livePlayers[tostring(plr.UserId)]=true end
            for uid in pairs(S.ownerKnownUsers) do
                if not livePlayers[uid] then
                    S.ownerKnownUsers[uid]=nil
                elseif not present[uid] and not (S.cloudRecord.activeUsers or {})[uid] then
                    S.ownerKnownUsers[uid]=nil
                end
            end
            local sigParts={}
            for uid,info in pairs(S.ownerKnownUsers) do sigParts[#sigParts+1]=tostring(uid)..":"..tostring(info.name)..":"..tostring(info.rank) end
            table.sort(sigParts)
            local sig=table.concat(sigParts,"|")
            S.ownerUserCount.Text="Script Users: "..tostring(math.max(#active,table.getn(S.ownerKnownUsers)))
            local count=0
            for _,info in pairs(S.ownerKnownUsers) do
                if tonumber(info.userId)~=S.player.UserId then count=count+1 end
            end
            if sig~=S.ownerUiSignature then
                S.ownerUiSignature=sig
                clear(S.ownerPlayerFrame)
                for _,info in pairs(S.ownerKnownUsers) do
                    if tonumber(info.userId)~=S.player.UserId then buildPlayerRow(info) end
                end
