        local realChar=LocalPlayer.Character
        if not realChar or not realChar:FindFirstChild("HumanoidRootPart") then return false end
        stopAntiRe()
        realChar=LocalPlayer.Character
        if not realChar or not realChar:FindFirstChild("HumanoidRootPart") then return false end
        isDesynced=true
        S.antiReActive=true
        if S._startFavoriteCleanupConnections then S._startFavoriteCleanupConnections() end
        realChar.Archivable=true
        fakeChar=realChar:Clone()
        fakeChar.Name=LocalPlayer.Name.."_Fake"
        fakeChar.Parent=workspace
        S.antiReFakeChar=fakeChar
        for _,part in pairs(fakeChar:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored=false end
        end
        local animateScript=fakeChar:FindFirstChild("Animate")
        if animateScript then
            animateScript.Enabled=false
            task.wait()
            animateScript.Enabled=true
        end
        for _,part in pairs(realChar:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored=true end
        end
        LocalPlayer.Character=fakeChar

        antiReCamera=workspace.CurrentCamera
        cameraAngleX=0
        cameraAngleY=-15
        cameraDistance=12
        cameraTouchInput=nil
        lastTouchPos=nil

        table.insert(S.antiReInputConnections,UserInputService.InputBegan:Connect(function(input,gameProcessed)
            if gameProcessed or not isDesynced then return end
            if input.UserInputType==Enum.UserInputType.Touch then
                local screenSize=antiReCamera.ViewportSize
                if input.Position.X>(screenSize.X*0.4) then
                    cameraTouchInput=input
                    lastTouchPos=input.Position
                end
            elseif input.UserInputType==Enum.UserInputType.MouseButton2 then
                cameraTouchInput=input
                lastTouchPos=input.Position
            end
        end))
        table.insert(S.antiReInputConnections,UserInputService.InputChanged:Connect(function(input)
            if not isDesynced or input~=cameraTouchInput then return end
            if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement then
                if lastTouchPos then
                    local delta=input.Position-lastTouchPos
                    lastTouchPos=input.Position
                    cameraAngleX=cameraAngleX-delta.X*0.70
                    cameraAngleY=math.clamp(cameraAngleY-delta.Y*0.70,-75,75)
                end
            elseif input.UserInputType==Enum.UserInputType.MouseWheel then
                cameraDistance=math.clamp(cameraDistance-input.Position.Z*2,4,30)
            end
        end))
        table.insert(S.antiReInputConnections,UserInputService.InputEnded:Connect(function(input)
            if input==cameraTouchInput then cameraTouchInput=nil; lastTouchPos=nil end
        end))

        RunService:BindToRenderStep("AntiReCameraRender",Enum.RenderPriority.Camera.Value+1000,function()
            if not isDesynced or not fakeChar or LocalPlayer.Character~=fakeChar then return end
            local fakeHRP=fakeChar:FindFirstChild("HumanoidRootPart")
            if not fakeHRP then return end
            local targetPos=fakeHRP.Position+Vector3.new(0,2.5,0)
            local rotCFrame=CFrame.Angles(0,math.rad(cameraAngleX),0)*CFrame.Angles(math.rad(cameraAngleY),0,0)
            local camPos=targetPos+rotCFrame:VectorToWorldSpace(Vector3.new(0,0,cameraDistance))
            antiReCamera.CameraType=Enum.CameraType.Scriptable
            antiReCamera.CFrame=CFrame.new(camPos,targetPos)
        end)

        charAddedConn=LocalPlayer.CharacterAdded:Connect(function(newRealChar)
            if not isDesynced or not fakeChar then return end
            if newRealChar~=fakeChar then
                for _,part in pairs(newRealChar:GetChildren()) do
