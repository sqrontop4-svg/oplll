    local function getCuffTool()
        local char=S.player.Character
        if not char then return nil end
        local backpack=S.player:FindFirstChildOfClass("Backpack")
        local bestTool=nil
        local bestScore=0
        local function scoreTool(tool)
            if not tool or not tool:IsA("Tool") then return 0 end
            local name=tostring(tool.Name or ""):lower()
            local score=0
            if name:find("cuff",1,true) or name:find("handcuff",1,true) or name:find("arrest",1,true) then score=score+4 end
            if name:find("كلب",1,true) or name:find("كفش",1,true) or name:find("اعتقال",1,true) then score=score+4 end
            for _,d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    local rn=tostring(d.Name or ""):lower()
                    if rn:find("cuff",1,true) or rn:find("arrest",1,true) or rn:find("handcuff",1,true) then
                        score=score+5
                    elseif rn=="remoteevent" or rn=="remotefunction" then
                        score=score+1
                    end
                end
            end
            return score
        end
        local function inspect(container)
            if not container then return end
            for _,tool in ipairs(container:GetChildren()) do
                local score=scoreTool(tool)
                if score>bestScore then bestScore=score; bestTool=tool end
            end
        end
        inspect(char)
        inspect(backpack)
        return bestTool
    end

    local function executeCuff(targetPlayer)
        if S.cuffInProgress then return false end
        if not targetPlayer or targetPlayer == S.player or not targetPlayer.Parent then return false end
        if not targetPlayer.Character then return false end

        S.cuffInProgress = true
        local success = false
        local ok = pcall(function()
            local myChar = S.player.Character
            local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myChar or not myHumanoid or not myHRP then return end

            local tool = getCuffTool()
            if not tool then return end
            if tool.Parent == S.player.Backpack then
                myHumanoid:EquipTool(tool)
                task.wait(0.15)
            end

            local remote=nil
            local remoteScore=0
            for _,d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    local n=tostring(d.Name or ""):lower()
                    local score=1
                    if n:find("cuff",1,true) or n:find("handcuff",1,true) or n:find("arrest",1,true) then score=5 end
                    if n=="remoteevent" or n=="remotefunction" then score=2 end
                    if score>remoteScore then remoteScore=score; remote=d end
                end
            end
            if not remote then return end

            local targetHRP = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not targetHRP then return end

            local distance = (myHRP.Position - targetHRP.Position).Magnitude
            if distance > 15 then
                local oldCFrame = myHRP.CFrame
                local startTime = tick()
                while tick() - startTime < 0.4 do
                    if not targetPlayer.Parent or not targetPlayer.Character then break end
                    local currentTargetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not currentTargetHRP or not myHRP.Parent then break end
                    myHRP.CFrame = currentTargetHRP.CFrame * CFrame.new(0, 0, 0.5)
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer("Cuff", currentTargetHRP)
                    else
                        pcall(function() remote:InvokeServer("Cuff", currentTargetHRP) end)
                    end
                    task.wait(0.15)
                end
                if myHRP.Parent then myHRP.CFrame = oldCFrame end
            else
                if remote:IsA("RemoteEvent") then
                    remote:FireServer("Cuff", targetHRP)
                else
                    pcall(function() remote:InvokeServer("Cuff", targetHRP) end)
                end
            end
            success = true
        end)
        S.cuffInProgress = false
        return ok and success
    end

