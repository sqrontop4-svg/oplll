    local function hideOwnerMessage(obj)
        pcall(function()
            if isSQRGuiObject(obj) then return end
            if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end

            local t=tostring(obj.Text or ""):lower()

            local isForeverHeader = t:find("message from foreverhd",1,true)
                or t:find("message from owner",1,true)
                or (t:find("message from",1,true) and (t:find("foreverhd",1,true) or t:find("owner",1,true)))
            local isForeverBody = t:find("settings prevent you from sending",1,true)
                or t:find("your chat settings prevent you from sending",1,true)

            if not (isForeverHeader or isForeverBody) then return end

            local cur=obj
            local target=nil
            local previous=obj

            for _=1,12 do
                cur=cur.Parent
                if not cur then break end

                local n=tostring(cur.Name or ""):lower()
                if n=="sqr_ui" or n=="protectioncenterui" or n:find("cmdbar",1,true) then
                    break
                end

                if cur:IsA("ScreenGui") or cur:IsA("CoreGui") then
                    break
                end

                if cur:IsA("GuiObject") then
                    target=cur
                end

                previous=cur
            end

            if target and target.Parent then
                target.Visible=false
            else
                obj.Visible=false
            end
            obj.Visible=false
        end)
    end
