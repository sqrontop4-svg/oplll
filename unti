    end

    local function jsRequest(method,body)
        local req=requestFn()
        if not req then return false,nil,"request function not found" end
        local actualMethod=(method=="PUT" and "PATCH" or method)
        local url=S.SUPABASE_STATE_URL
        if actualMethod=="GET" then
            url=url.."?id=eq.1&select=data"
        else
            url=url.."?id=eq.1"
        end
        local options={
            Url=url,
            Method=actualMethod,
            Headers={
                ["apikey"]=S.SUPABASE_KEY,
                ["Authorization"]="Bearer "..S.SUPABASE_KEY,
                ["Content-Type"]="application/json",
                ["Prefer"]="return=representation"
            }
        }
        if actualMethod~="GET" then options.Body=body end
        local ok,res=pcall(function() return req(options) end)
        if not ok or not res then return false,nil,tostring(res or "request failed") end
        local code=tonumber(res.StatusCode) or 0
        local responseBody=tostring(res.Body or "")
        if code<200 or code>=300 then return false,responseBody,"HTTP "..tostring(code).." "..responseBody end
        return true,responseBody,nil
    end

    local function jsGet()
